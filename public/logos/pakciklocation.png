            {
              "@type": "Question",
              "name": "Apakah itu Formula Ketirisan Jualan UOPS Pakciklocation?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Formula UOPS (Unrealised Organic Potential Sales) mengira potensi jualan fizikal yang terlepas akibat ranking rendah pada Google Maps: UOPS = Customers x Purata Belanja, di mana Directions Gap dihitung dari sasaran 7% CTR daripada jumlah carian tempatan (TLSV)."
              }
            },
            {
              "@type": "Question",
              "name": "Apakah dokumen rasmi yang diperlukan untuk rayuan GBP Suspended di Malaysia?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Dokumen rasmi yang sah mengikut piawaian Malaysia ialah Sijil SSM (Borang A, Borang 9 atau Borang 13), Bil Utiliti Premis 90 hari terkini (TNB, Air atau Internet dengan nama dan alamat sepadan), Lesen Premis Pihak Berkuasa Tempatan (PBT seperti DBKL, MBPJ, MBSA) dan Sijil Cap Dagang MYIPO."
              }
            },
            {
              "@type": "Question",
              "name": "Apakah peraturan Continuous Video Verification Google 2026?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Video pengesahan mesti dirakam dalam 1 rakaman berterusan (tanpa potongan) merangkumi: Papan tanda luaran dan mercu tanda jalan, operasi dalaman bersama stok barangan, serta bukti pengurusan seperti membuka kunci pintu atau log masuk terminal POS."
              }
            },
            {
              "@type": "Question",
              "name": "Bagaimanakah cara memadam ulasan palsu (Fake Review) pada Google Business Profile?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Gunakan Google Review Management Tool rasmi untuk 'Report review', pilih klausa pelanggaran dasar (Fake Engagement atau Conflict of Interest), dan jika ditolak dalam 3 hari, buat rayuan One-Shot dengan melampirkan rekod semakan POS/invois yang membuktikan individu tersebut bukan pelanggan."
              }
            }
          ]
        }
